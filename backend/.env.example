# Copy to backend/.env and fill in. backend/.env is gitignored - never commit real keys.

# --- Gemini (AI travel assistant) ---------------------------------------------
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default: gemini-3.1-flash-lite
# GEMINI_MODEL=gemini-3.1-flash-lite
# Optional model tried when the main one is busy/retired. Set empty to disable.
# GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# --- Google Places API (New) (live Explore / Map / restaurant results) ---------
# A SERVER key: enable "Places API (New)" only, restrict it by API and (when
# deployed) by your server's IP address. Do NOT reuse the Android Maps key.
PLACES_API_KEY=

# --- Cost and abuse protection (optional) ---------------------------------------
# Seconds identical place searches are served from memory (default 600).
# PLACES_CACHE_SECONDS=600
# Requests per minute per client IP (default 60).
# RATE_LIMIT_PER_MINUTE=60
# Global daily caps; 0 disables a cap (defaults 1000 / 500).
# DAILY_PLACES_LIMIT=1000
# DAILY_CHAT_LIMIT=500
