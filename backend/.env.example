# Copy this file to backend/.env (never commit the real key).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Optional override, defaults to gemini-3.1-flash-lite.
# gemini-3.8-flash is newer but may return 503 under high demand.
# GEMINI_MODEL=gemini-3.1-flash-lite
